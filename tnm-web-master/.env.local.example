# Projeto Supabase "WEB" (banco administrativo — usuarios, obras, fonogramas,
# importacoes, receitas, repasses). Usado por lib/supabase/client.ts e server.ts.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_web_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_web_anon_key

# Projeto Supabase "APP" (banco do app do artista — artistas, obras, shows,
# contratos, transacoes_financeiras). Usado por lib/supabaseApp.ts.
NEXT_PUBLIC_SUPABASE_APP_URL=your_supabase_app_project_url
NEXT_PUBLIC_SUPABASE_APP_ANON_KEY=your_supabase_app_anon_key

# Service role key do projeto APP — SOMENTE server-side (lib/supabaseAppServer.ts).
# Usada pelas rotas app/api/admin/** para o painel administrativo (que autentica
# no projeto WEB) poder ler/gravar artistas, shows e contratos do projeto APP
# mesmo com RLS habilitado lá (veja supabase/hardening_rls_app.sql).
# NUNCA prefixar com NEXT_PUBLIC_ — isso exporia a chave no navegador.
SUPABASE_APP_SERVICE_ROLE_KEY=your_supabase_app_service_role_key
